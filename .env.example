# ─────────────────────────────────────────────────────────────
# ลิสต์ตัวแปรทั้งหมดที่โปรเจกต์นี้ใช้
#
# คลาสนี้รันบน Claude Code Cloud Session → ก๊อปไฟล์นี้ทั้งก้อนไปวางใน
#   claude.ai/code → ไอคอนรูปเมฆ → Environment variables
# แล้วเติมค่าหลัง = ให้ครบ (รูปแบบเดียวกันเป๊ะ)
#
#   ⚠️ ค่าถูกอ่านตอน session เริ่มครั้งเดียว — ใส่ค่าใหม่แล้วต้อง "เปิด session ใหม่"
#   ⚠️ Environment variables ไม่ใช่ที่เก็บ secret (ใครใช้ environment นั้นอ่านได้)
#      → test key เท่านั้น และ revoke ทุกตัวหลังเรียนจบ
#
# ทำบนเครื่องตัวเองก็ได้: cp .env.example .env แล้วเติมค่า
#   (loadEnv() อ่าน .env แบบไม่ทับ env var ที่มีอยู่ → ใช้ได้ทั้งสองทาง)
#   ห้าม commit .env (.gitignore กันไว้แล้ว)
#
# วิธีหา key แต่ละตัว: technical-setup.md (root ของรีโป) ส่วน B
# ─────────────────────────────────────────────────────────────

# ── HubSpot (CRM) ────────────────────────────────────────────
# ⚠️ ต้องใส่ค่านี้แม้จะต่อ HubSpot connector แล้ว — connector สร้าง "นิยาม property"
#    ไม่ได้ แต่ขั้น 3 ต้องสร้าง custom deal property ผ่าน setup-hubspot.mjs
#    และ api/lead.js บน Vercel ก็ต้องมี token ตอน runtime
# Development → Keys → Service Keys → Create service key
# ชื่อตัวแปรยังเป็น _PRIVATE_APP_ ตามเดิม เพราะ service key ก็เป็น Bearer token
# prefix pat-na1-… เหมือนกัน ใส่ค่าลงตัวแปรนี้ได้เลยไม่ต้องแก้โค้ด
HUBSPOT_PRIVATE_APP_TOKEN=

# ── Stripe (Payment — ใช้ Sandbox เท่านั้นในคลาส) ─────────────
# 3 ค่าข้างล่างเป็นค่าต่างกันจริง มาจากคนละหน้าใน dashboard อย่าสับสน
#
# ⚠️ ถ้าต่อ Stripe connector แล้ว 2 ค่าแรกไม่ต้องใส่ที่นี่ — ใส่แค่ใน Vercel
#    (Claude สร้าง product/price/webhook ผ่าน connector ได้ แต่ api/ บน Vercel ทำไม่ได้)
#
# sk_test_… จาก Developers → API keys  ·  ใส่ใน Vercel
STRIPE_SECRET_KEY=
# whsec_… — ให้ Claude สร้าง webhook endpoint แล้วคืนค่านี้มาให้ (คืนตอนสร้างครั้งเดียว)
# หรือ Developers → Webhooks → Add endpoint → copy signing secret  ·  ใส่ใน Vercel
# (ต้อง deploy ก่อนจึงจะมี URL ให้ตั้ง endpoint)
STRIPE_WEBHOOK_SECRET=

# ── Image generation (จำเป็น — ใช้สร้างรูปบนหน้าเพจ) ──────────
# KIE.ai (โมเดล GPT Image 2) — key แจกในคลาส มีค่าใช้จ่ายต่อรูป ใช้อย่างประหยัด
KIE_API_KEY=
# Pixabay (ฟรี) — ดึง stock photo / icon / graphic
PIXABAY_API_KEY=

# ── Tracking (ข้ามได้ — ไม่มีก็แค่ track ไม่ได้) ───────────────
# GA4 Measurement ID เช่น G-XXXXXXXXXX
PUBLIC_GA4_MEASUREMENT_ID=
# Facebook (Meta) Pixel ID เช่น 1234567890
PUBLIC_FB_PIXEL_ID=

# ── Site ─────────────────────────────────────────────────────
# ⚠️ ไม่ต้องใส่ใน Vercel — โค้ด fallback ไป VERCEL_PROJECT_PRODUCTION_URL ที่ Vercel ตั้งให้เอง
#    ใส่ที่นี่ (ฝั่งเซสชัน/เครื่องตัวเอง) เพราะ test-lead.mjs ไม่ได้รันบน Vercel
#    ใส่ URL ที่ Vercel ให้หลัง deploy ครั้งแรก · ตอน dev บนเครื่องใช้ localhost:3000
SITE_URL=http://localhost:3000
