# ─────────────────────────────────────────────────────────────
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่า  →  cp .env.example .env
# ห้าม commit .env (มี .gitignore กันไว้แล้ว)
# วิธีหา key แต่ละตัว: ดู workspace/salepage_glow/technical-setup.md ส่วน B
# ─────────────────────────────────────────────────────────────

# ── HubSpot (CRM) ────────────────────────────────────────────
# Settings → Integrations → Private Apps → Create private app
HUBSPOT_PRIVATE_APP_TOKEN=
# เลข Hub ID มุมขวาบนของ HubSpot (ใช้ตอน debug / ลิงก์ไปหา record)
HUBSPOT_PORTAL_ID=

# ── Stripe (Payment — ใช้ Sandbox เท่านั้นในคลาส) ─────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# ได้จาก `stripe listen` หรือหน้า Webhooks ใน dashboard
STRIPE_WEBHOOK_SECRET=

# ── Image generation ─────────────────────────────────────────
# KIE.ai (โมเดล GPT Image 2) — key แจกในคลาส มีค่าใช้จ่ายต่อรูป ใช้อย่างประหยัด
KIE_API_KEY=
# Pixabay (ฟรี) — ดึง stock photo / icon / graphic
PIXABAY_API_KEY=

# ── Tracking ─────────────────────────────────────────────────
# GA4 Measurement ID เช่น G-XXXXXXXXXX
PUBLIC_GA4_MEASUREMENT_ID=
# Facebook (Meta) Pixel ID เช่น 1234567890
PUBLIC_FB_PIXEL_ID=

# ── Site ─────────────────────────────────────────────────────
# ตอน dev ใช้ http://localhost:3000 / ตอน prod ใส่ URL ที่ Vercel ให้
SITE_URL=http://localhost:3000
